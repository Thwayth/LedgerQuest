# Telegram bot token from @BotFather. Never commit the real value.
BOT_TOKEN=

# Public HTTPS URL of this app (Telegram Mini Apps require HTTPS).
WEB_APP_URL=https://your-service.onrender.com

PORT=10000

# PostgreSQL connection string (Supabase, Render Postgres, ...).
# Without it progress is kept in memory and is lost on every restart.
DATABASE_URL=

# Your numeric Telegram ID — the bot notifies you when a reward is claimed.
ADMIN_CHAT_ID=

# Your public @username without "@" — used for the "message admin" button.
ADMIN_USERNAME=

# When the daily quest resets (IANA time zone name).
QUEST_TZ=Europe/Kyiv

# Questions per daily quest (picked from the pool in questions.js).
QUESTIONS_PER_DAY=5

# Allow opening the app in a normal browser (demo users with separate ids).
# Set to false in production to allow only real Telegram users.
ALLOW_DEMO=true

# How long Telegram session data stays valid, in seconds (default 24h).
INIT_DATA_MAX_AGE_SECONDS=86400
